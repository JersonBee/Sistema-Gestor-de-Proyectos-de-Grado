<sql:query var="actas" dataSource="${bd}">SELECT a.id,a.numero,a.descripcion,a.aprobada_en,to_char(a.fecha,'DD/MM/YYYY') AS fecha FROM grado.acta a JOIN grado.acta_proyecto ap ON ap.acta_id=a.id WHERE ap.proyecto_id=CAST(? AS bigint) AND grado.puede_consultar_acta(CAST(? AS bigint),a.id) ORDER BY a.fecha DESC,a.id DESC<sql:param value="${param.id}" /><sql:param value="${usuarioActual.id}" /></sql:query>
