<sql:query var="movimientos" dataSource="${bd}">SELECT e.datos_anteriores->>'rol' AS rol_anterior,e.datos_anteriores->>'estado' AS estado_anterior,e.datos_nuevos->>'rol' AS rol_nuevo,e.datos_nuevos->>'estado' AS estado_nuevo,u.nombre,to_char(e.creado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha FROM grado.evento_auditoria e JOIN grado.usuario u ON u.id=e.actor_id WHERE e.entidad='usuario' AND e.entidad_id=CAST(? AS bigint) AND e.accion='administrar_cuenta' ORDER BY e.id DESC LIMIT 30<sql:param value="${param.usuario}" /></sql:query>
