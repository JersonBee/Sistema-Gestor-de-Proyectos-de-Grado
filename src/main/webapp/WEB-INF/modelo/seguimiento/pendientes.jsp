<sql:query var="pendientes" dataSource="${bd}">SELECT r.id,r.etapa,r.responsable_id,coalesce(u.nombre,'Comité') AS responsable,to_char(r.limite_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS limite FROM grado.revision_entrega r JOIN grado.ciclo_revision c ON c.id=r.ciclo_id JOIN grado.entrega_revision e ON e.id=c.entrega_id LEFT JOIN grado.usuario u ON u.id=r.responsable_id WHERE e.fase_origen_id=CAST(? AS bigint) AND c.finalizado_en IS NULL AND r.decision IS NULL<sql:param value="${proyecto.fase_id}" /></sql:query>
