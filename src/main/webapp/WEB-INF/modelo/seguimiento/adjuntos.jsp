<sql:query var="adjuntos" dataSource="${bd}">SELECT ed.entrega_id,v.id AS version_id,v.url,v.numero,d.etiqueta,t.nombre FROM grado.entrega_documento_version ed JOIN grado.documento d ON d.id=ed.documento_id JOIN grado.documento_version v ON v.id=ed.version_id JOIN grado.tipo_documento t ON t.codigo=d.tipo_codigo WHERE d.proyecto_fase_id=CAST(? AS bigint) ORDER BY d.id<sql:param value="${proyecto.fase_id}" /></sql:query>
