<sql:query var="correcciones" dataSource="${bd}">SELECT to_char(pc.limite_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS limite,pc.alertada_en FROM grado.plazo_correccion pc JOIN grado.revision_entrega r ON r.id=pc.revision_id JOIN grado.ciclo_revision c ON c.id=r.ciclo_id JOIN grado.entrega_revision e ON e.id=c.entrega_id WHERE e.fase_origen_id=CAST(? AS bigint) AND pc.entrega_reenvio_id IS NULL ORDER BY pc.inicio_en DESC LIMIT 1<sql:param value="${proyecto.fase_id}" /></sql:query>
