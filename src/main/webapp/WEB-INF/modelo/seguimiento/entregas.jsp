<sql:query var="entregas" dataSource="${bd}">SELECT e.id,e.numero,c.finalizado_en,to_char(e.presentada_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha,u.nombre AS autor FROM grado.entrega_revision e JOIN grado.ciclo_revision c ON c.entrega_id=e.id JOIN grado.usuario u ON u.id=e.presentada_por WHERE e.fase_origen_id=CAST(? AS bigint) ORDER BY e.numero DESC<sql:param value="${proyecto.fase_id}" /></sql:query>
