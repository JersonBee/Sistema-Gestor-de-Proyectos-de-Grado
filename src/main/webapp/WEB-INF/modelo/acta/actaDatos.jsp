<sql:query var="actaDatos" dataSource="${bd}">SELECT a.id,a.numero,a.descripcion,a.detalles,a.aprobada_en,u.nombre AS creada_por,aprobador.nombre AS aprobada_por,to_char(a.fecha,'DD/MM/YYYY') AS fecha,to_char(a.aprobada_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS aprobacion FROM grado.acta a JOIN grado.usuario u ON u.id=a.creada_por LEFT JOIN grado.usuario aprobador ON aprobador.id=a.aprobada_por WHERE a.id=CAST(? AS bigint) AND grado.puede_consultar_acta(CAST(? AS bigint),a.id)<sql:param value="${param.acta}" /><sql:param value="${usuarioActual.id}" /></sql:query>
