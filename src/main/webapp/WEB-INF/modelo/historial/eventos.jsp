<sql:query var="eventos" dataSource="${bd}">SELECT initcap(replace(e.accion,'_',' ')) AS accion,coalesce(u.nombre,'Sistema') AS actor,coalesce(e.datos_nuevos->>'detalle',e.datos_nuevos->>'reporte','') AS detalle,to_char(e.creado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha FROM grado.evento_auditoria e LEFT JOIN grado.usuario u ON u.id=e.actor_id WHERE e.proyecto_id=CAST(? AS bigint) ORDER BY e.creado_en DESC,e.id DESC LIMIT 21 OFFSET CAST(? AS integer)<sql:param value="${param.id}" /><sql:param value="${(pagina-1)*20}" /></sql:query>
