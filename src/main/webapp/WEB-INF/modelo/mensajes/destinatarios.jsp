<sql:query var="destinatarios" dataSource="${bd}">SELECT u.id,u.nombre FROM grado.usuario u WHERE u.estado='activo' AND ((CAST(? AS text)='estudiante' AND u.rol_codigo='director' AND EXISTS(SELECT 1 FROM grado.asignacion_proyecto ap WHERE ap.proyecto_id=CAST(? AS bigint) AND ap.docente_id=u.id AND ap.funcion='director' AND ap.fin_en IS NULL) AND CAST(? AS boolean)) OR (CAST(? AS text)='director' AND u.rol_codigo='estudiante' AND EXISTS(SELECT 1 FROM grado.participante_proyecto pp WHERE pp.proyecto_id=CAST(? AS bigint) AND pp.estudiante_id=u.id AND pp.retiro_en IS NULL) AND CAST(? AS boolean))) ORDER BY u.nombre<sql:param value="${usuarioActual.rol_codigo}" /><sql:param value="${param.id}" /><sql:param value="${proyectoVista.integrante}" /><sql:param value="${usuarioActual.rol_codigo}" /><sql:param value="${param.id}" /><sql:param value="${proyectoVista.es_director}" /></sql:query>
