<sql:query var="mensajes" dataSource="${bd}">SELECT m.id,m.contenido,m.remitente_id,m.destinatario_id,m.leido_en,r.nombre AS remitente,d.nombre AS destinatario,to_char(m.enviado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha FROM grado.mensaje m JOIN grado.usuario r ON r.id=m.remitente_id JOIN grado.usuario d ON d.id=m.destinatario_id WHERE m.proyecto_id=CAST(? AS bigint) AND (m.remitente_id=CAST(? AS bigint) OR m.destinatario_id=CAST(? AS bigint)) ORDER BY m.enviado_en DESC,m.id DESC LIMIT 21 OFFSET CAST(? AS integer)<sql:param value="${param.id}" /><sql:param value="${usuarioActual.id}" /><sql:param value="${usuarioActual.id}" /><sql:param value="${(pagina-1)*20}" /></sql:query>
