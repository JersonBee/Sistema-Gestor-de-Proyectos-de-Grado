<sql:query var="detalle" dataSource="${bd}">SELECT p.id, p.titulo, p.descripcion, p.objetivos, p.estado, p.finalizado_en, m.nombre AS modalidad, i.titulo AS idea FROM grado.proyecto p JOIN grado.modalidad m ON m.id = p.modalidad_id JOIN grado.idea i ON i.id = p.idea_id WHERE p.id = CAST(? AS bigint) AND grado.puede_consultar_proyecto(CAST(? AS bigint),p.id)<sql:param value="${param.id}" /><sql:param value="${usuarioActual.id}" /></sql:query>
