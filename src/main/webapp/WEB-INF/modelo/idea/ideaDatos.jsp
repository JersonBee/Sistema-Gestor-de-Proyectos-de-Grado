<sql:query var="ideaDatos" dataSource="${bd}">SELECT i.*,m.nombre AS modalidad,a.nombre AS area,l.nombre AS linea,u.nombre AS autor,EXISTS(SELECT 1 FROM grado.proyecto p WHERE p.idea_id=i.id AND p.estado<>'cancelado') AS reservada FROM grado.idea i JOIN grado.modalidad m ON m.id=i.modalidad_id JOIN grado.area_experiencia a ON a.id=i.area_id JOIN grado.linea_investigacion l ON l.id=i.linea_id JOIN grado.usuario u ON u.id=i.autor_id WHERE i.id=CAST(? AS bigint) AND grado.puede_consultar_idea(CAST(? AS bigint),i.id)<sql:param value="${param.id}" /><sql:param value="${usuarioActual.id}" /></sql:query>
