<sql:query var="notificaciones" dataSource="${bd}">SELECT n.id,n.asunto,n.cuerpo,n.leido_en,e.proyecto_id,to_char(n.creado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha FROM grado.notificacion n JOIN grado.evento_auditoria e ON e.id=n.evento_id WHERE n.destinatario_id=CAST(? AS bigint) ORDER BY n.creado_en DESC,n.id DESC LIMIT 21 OFFSET CAST(? AS integer)<sql:param value="${usuarioActual.id}" /><sql:param value="${(pagina-1)*20}" /></sql:query>
