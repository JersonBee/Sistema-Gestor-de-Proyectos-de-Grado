<sql:query var="documentosFinales" dataSource="${bd}">SELECT t.nombre,d.tipo_codigo,v.id AS version_id,v.numero,v.url,to_char(v.creado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha,u.nombre AS autor FROM grado.documento d JOIN grado.proyecto_fase pf ON pf.id=d.proyecto_fase_id JOIN grado.documento_version v ON v.documento_id=d.id JOIN grado.tipo_documento t ON t.codigo=d.tipo_codigo JOIN grado.usuario u ON u.id=v.registrado_por WHERE d.proyecto_id=CAST(? AS bigint) AND pf.fase_codigo='final' ORDER BY v.creado_en DESC,v.id DESC<sql:param value="${param.id}" /></sql:query>
