<sql:query var="datosFinales" dataSource="${bd}">SELECT ef.tipo_licencia,ef.repositorio_url,u.nombre AS director,to_char(ef.repositorio_registrado_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fecha FROM grado.entrega_final ef LEFT JOIN grado.usuario u ON u.id=ef.repositorio_registrado_por WHERE ef.proyecto_id=CAST(? AS bigint)<sql:param value="${param.id}" /></sql:query>
