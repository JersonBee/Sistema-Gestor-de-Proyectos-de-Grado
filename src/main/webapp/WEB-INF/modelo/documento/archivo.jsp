<sql:query var="archivo" dataSource="${bd}">SELECT v.url,v.numero,d.proyecto_id,t.nombre FROM grado.documento_version v JOIN grado.documento d ON d.id=v.documento_id JOIN grado.tipo_documento t ON t.codigo=d.tipo_codigo WHERE v.id=CAST(? AS bigint) AND grado.puede_consultar_proyecto(CAST(? AS bigint),d.proyecto_id)<sql:param value="${param.version}" /><sql:param value="${usuarioActual.id}" /></sql:query>
