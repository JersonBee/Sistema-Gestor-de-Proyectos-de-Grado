<sql:query var="adjuntos" dataSource="${bd}">SELECT ed.entrega_id,v.url,t.nombre,d.etiqueta FROM grado.entrega_documento_version ed JOIN grado.documento d ON d.id=ed.documento_id JOIN grado.tipo_documento t ON t.codigo=d.tipo_codigo JOIN grado.documento_version v ON v.id=ed.version_id JOIN grado.proyecto_fase f ON f.id=d.proyecto_fase_id WHERE ed.proyecto_id=CAST(? AS bigint) AND f.fase_codigo='pago' ORDER BY d.id<sql:param value="${param.id}" /></sql:query>
