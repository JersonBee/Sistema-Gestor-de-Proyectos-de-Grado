<sql:query var="participantesPago" dataSource="${bd}">SELECT nombre_en_pago,documento_en_pago,correo_en_pago,telefono_en_pago,(retiro_en IS NOT NULL) AS historica,to_char(retiro_en AT TIME ZONE 'America/Bogota','DD/MM/YYYY HH24:MI') AS fin FROM grado.participante_proyecto WHERE proyecto_id=CAST(? AS bigint) ORDER BY plaza,ingreso_en,id<sql:param value="${param.id}" /></sql:query>
