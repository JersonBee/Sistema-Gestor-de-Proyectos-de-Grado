<sql:query var="aptos" dataSource="${bd}">SELECT u.id,u.nombre,u.rol_codigo FROM grado.docente_apto_idea a JOIN grado.usuario u ON u.id=a.docente_id WHERE a.idea_id=CAST(? AS bigint) AND NOT EXISTS(SELECT 1 FROM grado.asignacion_proyecto ap WHERE ap.proyecto_id=CAST(? AS bigint) AND ap.docente_id=u.id AND ap.fin_en IS NULL) ORDER BY u.rol_codigo,u.nombre<sql:param value="${proyectoVista.idea_id}" /><sql:param value="${param.id}" /></sql:query>
