<sql:query var="cuentas" dataSource="${bd}">SELECT u.id,u.nombre,u.correo,u.estado,r.nombre AS rol FROM grado.usuario u JOIN grado.rol r ON r.codigo=u.rol_codigo WHERE (coalesce(CAST(? AS text),'')='' OR u.nombre ILIKE '%'||CAST(? AS text)||'%' OR u.correo ILIKE '%'||CAST(? AS text)||'%') ORDER BY u.nombre,u.id LIMIT 21 OFFSET CAST(? AS integer)<sql:param value="${param.q}" /><sql:param value="${param.q}" /><sql:param value="${param.q}" /><sql:param value="${(pagina-1)*20}" /></sql:query>
