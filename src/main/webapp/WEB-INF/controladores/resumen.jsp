<%@ include file="/WEB-INF/controladores/comun/inicio.jsp" %><%@ include file="/WEB-INF/controladores/comun/seguridad.jsp" %><%@ include file="/WEB-INF/controladores/comun/proyecto-acceso.jsp" %>
<%@ include file="/WEB-INF/modelo/resumen/estado.jsp" %><c:set var="estadoProyecto" value="${estadoResumen.rows[0]}" />
<%@ include file="/WEB-INF/modelo/proyecto/docentes.jsp" %>
<c:set var="destinoResumen" value="/seguimiento.jsp" /><c:set var="tipoResumen" value="${fn:startsWith(estadoProyecto.fase_codigo,'informe') ? 'informe' : 'propuesta'}" />
<c:set var="responsableResumen" value="${empty estadoProyecto.estudiantes ? 'Estudiantes vigentes' : estadoProyecto.estudiantes}" />
<c:set var="documentosResumen" value="${tipoResumen eq 'informe' ? 'F-DC-125, F-DC-129 y reporte Turnitin' : 'F-DC-124 y reporte Turnitin'}" />
<c:choose>
 <c:when test="${estadoProyecto.estado eq 'cancelado' or estadoProyecto.estado eq 'finalizado'}"><c:set var="accionResumen" value="El proceso está cerrado. Puedes consultar documentos y decisiones en el historial." /><c:set var="responsableResumen" value="Sin acciones pendientes del proceso" /><c:set var="documentosResumen" value="No hay entregas obligatorias pendientes." /><c:set var="destinoResumen" value="/historial.jsp" /></c:when>
 <c:when test="${estadoProyecto.estado eq 'desactivado'}"><c:set var="accionResumen" value="El proyecto está en pausa. El Comité debe reanudarlo para continuar los procedimientos." /><c:set var="responsableResumen" value="Comité" /><c:set var="documentosResumen" value="La pausa suspende las entregas y revisiones." /><c:set var="destinoResumen" value="/proyecto.jsp" /></c:when>
 <c:when test="${estadoProyecto.fase_codigo eq 'pago' and not empty estadoProyecto.pago_aprobado}"><c:set var="accionResumen" value="Asignar el director y el evaluador para comenzar Propuesta I." /><c:set var="responsableResumen" value="Comité" /><c:set var="documentosResumen" value="El conjunto de Pago ya fue aprobado." /><c:set var="destinoResumen" value="/pago.jsp" /></c:when>
 <c:when test="${not empty estadoProyecto.etapa}"><c:set var="accionResumen" value="Revisar el conjunto completo y registrar el reporte de respuesta." /><c:set var="responsableResumen" value="${estadoProyecto.responsable}" /><c:set var="documentosResumen" value="El conjunto está entregado y en revisión; no debes volver a enviarlo mientras se decide." /><c:if test="${estadoProyecto.fase_codigo eq 'pago'}"><c:set var="destinoResumen" value="/pago.jsp" /></c:if></c:when>
 <c:when test="${estadoProyecto.fase_codigo eq 'pago'}"><c:set var="accionResumen" value="Presentar el conjunto de Pago al Comité." /><c:set var="documentosResumen" value="Comprobante de pago y los adicionales que hayan sido solicitados (opcionales)." /><c:set var="destinoResumen" value="/pago.jsp" /></c:when>
 <c:when test="${estadoProyecto.fase_codigo eq 'final'}"><c:set var="accionResumen" value="El Comité puede finalizar el proyecto. Los adicionales no condicionan el cierre." /><c:set var="responsableResumen" value="Comité" /><c:set var="documentosResumen" value="No hay documentos adicionales obligatorios. Puedes registrar manual, licencia y evidencia; el director puede registrar el repositorio." /><c:set var="destinoResumen" value="/final.jsp" /></c:when>
 <c:when test="${estadoProyecto.fase_codigo eq 'informe_1' and not estadoProyecto.informe_disponible}"><c:set var="accionResumen" value="Esperar la habilitación de Informe I y preparar el conjunto de documentos." /></c:when>
 <c:otherwise><c:set var="accionResumen" value="${not empty estadoProyecto.limite_correccion ? 'Corregir y reenviar el conjunto completo a su director. El ciclo vuelve a comenzar.' : 'Presentar el conjunto completo al director para iniciar la revisión.'}" /></c:otherwise>
</c:choose>
<c:set var="tituloPagina" value="Resumen del proyecto" /><c:set var="menuActual" value="proyectos" />
<%@ include file="/WEB-INF/vistas/resumen.jsp" %>
