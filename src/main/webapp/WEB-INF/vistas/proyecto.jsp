<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<div class="acciones-documento"><a class="boton primario" href="<c:url value='/resumen.jsp'><c:param name='id' value='${param.id}' /></c:url>">Ver resumen y siguiente paso →</a></div>
<a class="volver" href="<c:url value='/panel.jsp' />">← Mis proyectos</a><section class="bienvenida-panel"><div><p class="sobretitulo">PROYECTO #<c:out value="${detalle.rows[0].id}" /></p><h1 class="titulo-proyecto"><c:out value="${detalle.rows[0].titulo}" /></h1><p><c:out value="${detalle.rows[0].modalidad}" /></p></div><span class="etiqueta-rol"><c:out value="${detalle.rows[0].estado}" /></span></section>
<section class="tarjeta detalle-cuenta"><h2>Resumen</h2><dl class="lista-datos"><dt>Idea</dt><dd><c:out value="${detalle.rows[0].idea}" /></dd><dt>Descripción</dt><dd><c:out value="${detalle.rows[0].descripcion}" /></dd><dt>Objetivos</dt><dd><c:out value="${detalle.rows[0].objetivos}" /></dd><dt>Participantes</dt><dd><c:forEach items="${integrantes.rows}" var="integrante"><p><c:out value="${integrante.nombre_en_pago}" /><c:if test="${not empty integrante.retiro_en}"> · <c:out value="${detalle.rows[0].estado eq 'finalizado' and integrante.retiro_en eq detalle.rows[0].finalizado_en ? 'Participación finalizada' : (detalle.rows[0].estado eq 'cancelado' ? 'Participación cerrada' : 'Retirado')}" /></c:if></p></c:forEach></dd><%@ include file="/WEB-INF/vistas/comun/docentes-resumen.jsp" %></dl></section>
<%@ include file="/WEB-INF/vistas/comun/fases-detalle.jsp" %>
<section class="tarjeta"><h2>Documentos de Pago</h2><p class="dato-secundario">Consulta el comprobante, los adicionales y las decisiones del Comité.</p><a class="boton primario" href="<c:url value='/pago.jsp'><c:param name='id' value='${param.id}' /></c:url>">Abrir fase Pago →</a></section>
<section class="tarjeta"><h2>Seguimiento documental</h2><p class="dato-secundario">Consulta las versiones entregadas, los reportes y quién tiene la siguiente revisión.</p><div class="acciones-documento"><a class="boton primario" href="<c:url value='/seguimiento.jsp'><c:param name='id' value='${param.id}' /><c:param name='tipo' value='propuesta' /></c:url>">Propuesta I / II →</a><a class="boton" href="<c:url value='/seguimiento.jsp'><c:param name='id' value='${param.id}' /><c:param name='tipo' value='informe' /></c:url>">Informe I / II →</a></div></section>
<section class="tarjeta"><h2>Final y trámites</h2><p class="dato-secundario">Entregables complementarios, solicitudes al Comité e historial del proyecto.</p><div class="acciones-documento"><a class="boton" href="<c:url value='/final.jsp'><c:param name='id' value='${param.id}' /></c:url>">Fase Final →</a><a class="boton" href="<c:url value='/solicitudes.jsp'><c:param name='id' value='${param.id}' /></c:url>">Solicitudes →</a><a class="boton" href="<c:url value='/historial.jsp'><c:param name='id' value='${param.id}' /></c:url>">Historial →</a></div></section>
<section class="tarjeta"><h2>Actas y comunicación</h2><p class="dato-secundario">Consulta las actas aprobadas y tu correspondencia privada del proyecto.</p><div class="acciones-documento"><a class="boton" href="<c:url value='/actas.jsp'><c:param name='id' value='${param.id}' /></c:url>">Actas →</a><a class="boton" href="<c:url value='/mensajes.jsp'><c:param name='id' value='${param.id}' /></c:url>">Mis mensajes →</a></div></section>
<%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${usuarioActual.rol_codigo eq 'comite' and (detalle.rows[0].estado eq 'activo' or detalle.rows[0].estado eq 'desactivado')}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/proyecto-pausa.jsp' />"><h2>Control del proyecto</h2><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><c:choose><c:when test="${detalle.rows[0].estado eq 'activo'}"><p class="dato-secundario">Pausar detiene los trámites y los plazos pendientes. Al reanudar, cada día o fracción de pausa se repone como un día calendario, conservando las horas de cierre.</p><input type="hidden" name="operacion" value="pausar"><label for="motivo">Motivo de la pausa</label><textarea id="motivo" name="motivo" rows="3" maxlength="12000" required></textarea><button class="boton" type="submit">Pausar proyecto</button></c:when><c:otherwise><p class="dato-secundario">Al reanudar, los plazos pendientes se ajustarán por la pausa registrada.</p><input type="hidden" name="operacion" value="reanudar"><button class="boton primario" type="submit">Reanudar proyecto</button></c:otherwise></c:choose></form></c:if>

<c:if test="${not empty pausas.rows}"><section class="tarjeta historial"><h2>Historial de pausas</h2><c:forEach items="${pausas.rows}" var="pausa"><article><p class="dato-secundario"><c:out value="${pausa.inicio}" /> → <c:out value="${pausa.fin}" default="En pausa" /></p><p class="texto-largo"><c:out value="${pausa.motivo}" /></p></article></c:forEach></section></c:if>
