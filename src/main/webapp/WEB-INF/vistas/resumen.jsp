<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a>
<section class="bienvenida-panel"><div><p class="sobretitulo">RESUMEN · PROYECTO #<c:out value="${estadoProyecto.id}" /></p><h1 class="titulo-proyecto"><c:out value="${estadoProyecto.titulo}" /></h1><p><c:out value="${estadoProyecto.modalidad}" /></p></div><span class="etiqueta-rol"><c:out value="${estadoProyecto.estado}" /></span></section>
<section class="tarjeta"><h2>Tu siguiente paso</h2><dl class="lista-datos"><dt>Fase actual o de cierre</dt><dd><c:out value="${estadoProyecto.fase}" default="Por iniciar" /></dd><dt>Resultado de la fase</dt><dd><c:out value="${estadoProyecto.resultado_fase}" default="En curso" /></dd><dt>Responsable</dt><dd><c:out value="${responsableResumen}" /><c:if test="${not empty estadoProyecto.etapa and estadoProyecto.estado eq 'activo'}"> · <c:out value="${estadoProyecto.etapa}" /></c:if></dd><dt>Siguiente acción</dt><dd><c:out value="${accionResumen}" /></dd><dt>Documentos pendientes</dt><dd><c:out value="${documentosResumen}" /></dd></dl>
<a class="boton primario" href="<c:url value='${destinoResumen}'><c:param name='id' value='${param.id}' /><c:if test="${destinoResumen eq '/seguimiento.jsp'}"><c:param name='tipo' value='${tipoResumen}' /></c:if></c:url>">Abrir detalle del siguiente paso →</a></section>
<section class="tarjeta"><h2>Equipo docente</h2><dl class="lista-datos"><%@ include file="/WEB-INF/vistas/comun/docentes-resumen.jsp" %></dl></section>
<section class="tarjeta"><h2>Fechas y plazos</h2><p class="dato-secundario">Hora de Bogotá · Todos los días cuentan.</p>
<c:choose><c:when test="${estadoProyecto.estado eq 'desactivado'}"><p>Los plazos están suspendidos. Al reanudar se ajustan por los días de pausa.</p></c:when><c:when test="${estadoProyecto.estado eq 'cancelado' or estadoProyecto.estado eq 'finalizado'}"><p>El proceso está cerrado y no tiene plazos de entrega o revisión activos.</p></c:when><c:otherwise>
<c:if test="${not empty estadoProyecto.limite_revision}"><p><strong>Revisión hasta:</strong> <c:out value="${estadoProyecto.limite_revision}" /></p></c:if><c:if test="${estadoProyecto.etapa eq 'comite'}"><p>La revisión del Comité no tiene un plazo automático de cinco días.</p></c:if>
<c:if test="${empty estadoProyecto.etapa and not empty estadoProyecto.limite_correccion}"><p><strong>Corrección hasta:</strong> <c:out value="${estadoProyecto.limite_correccion}" /></p><p class="${estadoProyecto.correccion_vencida ? 'aviso' : 'dato-secundario'}"><c:out value="${estadoProyecto.correccion_vencida ? 'El plazo de corrección terminó. Recibirás una alerta y puedes reenviar el conjunto.' : 'Si termina el plazo de corrección, recibirás una alerta y podrás reenviar.'}" /></p></c:if>
<c:choose><c:when test="${not empty estadoProyecto.informe_aprobado_comite_en}"><p>El Comité aprobó Informe II. La cancelación por el plazo de 180 días está detenida.</p></c:when><c:when test="${not empty estadoProyecto.habilitado}"><p><strong>Informe I habilitado desde:</strong> <c:out value="${estadoProyecto.habilitado}" /></p><p><strong>Vigencia del proyecto hasta:</strong> <c:out value="${estadoProyecto.vence}" /></p></c:when><c:otherwise><p>La espera de 90 días y la vigencia de 180 días comenzarán al iniciar Informe I.</p></c:otherwise></c:choose>
</c:otherwise></c:choose></section>
<c:if test="${estadoProyecto.solicitudes_pendientes gt 0}"><section class="tarjeta"><h2>Trámites pendientes</h2><p>Solicitudes por resolver: <c:out value="${estadoProyecto.solicitudes_pendientes}" />.</p><a class="boton" href="<c:url value='/solicitudes.jsp'><c:param name='id' value='${param.id}' /></c:url>">Consultar solicitudes →</a></section></c:if>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
