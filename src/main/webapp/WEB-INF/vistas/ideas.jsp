<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<section class="bienvenida-panel"><div><p class="sobretitulo">EL PUNTO DE PARTIDA</p><h1>Banco de ideas<span class="saludo-punto">.</span></h1><p>Explora propuestas y encuentra los docentes que coinciden con cada idea.</p></div>
 <c:if test="${usuarioActual.rol_codigo eq 'estudiante' or usuarioActual.rol_codigo eq 'director'}"><a class="boton primario" href="<c:url value='/idea-nueva.jsp' />">Proponer idea <span aria-hidden="true">＋</span></a></c:if>
</section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<form class="barra-filtros" method="get"><label class="campo">Buscar por título<input name="q" maxlength="200" value="<c:out value='${param.q}' />" placeholder="¿Qué te gustaría desarrollar?"></label><label class="campo">Mostrar<select name="vista"><option value="">Todas las ideas visibles</option value="propias" ${param.vista eq 'propias' ? 'selected' : ''}>Mis propuestas</option></select></label><button class="boton" type="submit">Buscar</button></form>
<div class="rejilla-ideas"><c:forEach items="${ideas.rows}" var="idea" end="19"><article class="tarjeta tarjeta-idea"><div class="titulo-tarjeta"><span class="insignia"><c:out value="${idea.estado}" /></span><span class="dato-secundario"><c:out value="${idea.reservada ? 'Reservada' : (idea.estado eq 'aprobada' ? 'Disponible' : 'Propuesta')}" /></span></div><p class="sobretitulo"><c:out value="${idea.modalidad}" /></p><h2><a href="<c:url value='/idea.jsp'><c:param name='id' value='${idea.id}' /></c:url>"><c:out value="${idea.titulo}" /></a></h2><p class="dato-secundario"><c:out value="${idea.area}" /> · <c:out value="${idea.linea}" /></p><p class="autor-idea">Por <c:out value="${idea.autor}" /></p><a class="enlace-texto" href="<c:url value='/idea.jsp'><c:param name='id' value='${idea.id}' /></c:url>">Ver idea y docentes →</a></article></c:forEach></div>
<c:if test="${empty ideas.rows}"><section class="tarjeta estado-vacio"><h2>No encontramos ideas</h2><p>Prueba otro título o registra una propuesta propia. Las propuestas pendientes solo son visibles para su autor y el Comité.</p></section></c:if>
<nav class="paginacion" aria-label="Páginas del banco"><c:if test="${pagina gt 1}"><a class="boton" href="<c:url value='/ideas.jsp'><c:param name='pagina' value='${pagina-1}' /><c:param name='q' value='${param.q}' /><c:param name='vista' value='${param.vista}' /></c:url>">← Anterior</a></c:if><span class="dato-secundario">Página <c:out value="${pagina}" /></span><c:if test="${ideas.rowCount gt 20}"><a class="boton" href="<c:url value='/ideas.jsp'><c:param name='pagina' value='${pagina+1}' /><c:param name='q' value='${param.q}' /><c:param name='vista' value='${param.vista}' /></c:url>">Siguiente →</a></c:if></nav>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
