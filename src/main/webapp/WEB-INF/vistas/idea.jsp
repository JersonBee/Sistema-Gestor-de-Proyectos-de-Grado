<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/ideas.jsp' />">← Banco de ideas</a><section class="bienvenida-panel"><div><p class="sobretitulo"><c:out value="${idea.modalidad}" /></p><h1 class="titulo-proyecto"><c:out value="${idea.titulo}" /></h1><p>Propuesta por <c:out value="${idea.autor}" /></p></div><span class="etiqueta-rol"><c:out value="${idea.estado}" />${idea.reservada ? ' · Reservada' : ''}</span></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<div class="columnas-panel"><section class="tarjeta"><h2>Sobre esta idea</h2><dl class="lista-datos"><dt>Área</dt><dd><c:out value="${idea.area}" /></dd><dt>Línea</dt><dd><c:out value="${idea.linea}" /></dd><dt>Descripción</dt><dd><c:out value="${idea.descripcion}" /></dd><dt>Objetivos</dt><dd><c:out value="${idea.objetivos}" /></dd><dt>Tecnologías</dt><dd><c:out value="${idea.tecnologias}" /></dd></dl></section><aside class="tarjeta"><h2>Docentes aptos</h2><p class="dato-secundario">Coinciden en modalidad, área y línea de investigación.</p><c:forEach items="${aptos.rows}" var="docente"><p class="docente-apto"><strong><c:out value="${docente.nombre}" /></strong><span class="dato-secundario"><c:out value="${docente.rol_codigo}" /></span></p></c:forEach><c:if test="${empty aptos.rows}"><p class="dato-secundario">Aún no hay perfiles docentes que coincidan.</p></c:if></aside></div>
<c:if test="${usuarioActual.rol_codigo eq 'estudiante' and idea.estado eq 'aprobada' and not idea.reservada}"><a class="boton primario" href="<c:url value='/proyecto-nuevo.jsp'><c:param name='idea' value='${idea.id}' /></c:url>">Elegir idea e iniciar proyecto →</a></c:if>
<c:if test="${usuarioActual.rol_codigo eq 'comite' and idea.estado eq 'pendiente'}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/idea-decidir.jsp' />"><h2>Revisión del Comité</h2><p class="dato-secundario">La aprobación hace disponible esta idea para los estudiantes.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${idea.id}"><label for="decision">Decisión</label><select id="decision" name="decision" required><option value="">Selecciona</option><option value="aprobada">Aprobar idea</option><option value="rechazada">Rechazar idea</option></select><label for="reporte">Observaciones</label><textarea id="reporte" name="reporte" rows="4" maxlength="12000" required></textarea><button type="submit" class="boton primario">Guardar decisión</button></form></c:if>
<c:if test="${not empty decisiones.rows}"><section class="tarjeta historial"><h2>Decisiones registradas</h2><c:forEach items="${decisiones.rows}" var="d"><article><p class="dato-secundario"><c:out value="${d.fecha}" /> · <c:out value="${d.nombre}" /> · <c:out value="${d.decision}" /></p><p class="texto-largo"><c:out value="${d.observaciones}" /></p></article></c:forEach></section></c:if>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
