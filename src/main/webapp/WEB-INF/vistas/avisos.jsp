<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %><section class="bienvenida-panel"><div><p class="sobretitulo">NOVEDADES DEL PROCESO</p><h1>Mis avisos.</h1><p>Entregas, decisiones y alertas de vencimiento, en un solo lugar.</p></div></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${empty notificaciones.rows}"><section class="tarjeta estado-vacio"><h2>Sin avisos por ahora</h2><p>Aquí aparecerán las novedades de tus proyectos.</p></section></c:if>
<c:forEach items="${notificaciones.rows}" var="n" end="19"><article class="tarjeta"><div class="titulo-tarjeta"><h2><c:out value="${n.asunto}" /></h2><span class="insignia">${empty n.leido_en ? 'Nuevo' : 'Leído'}</span></div><p class="texto-largo"><c:out value="${n.cuerpo}" /></p><p class="dato-secundario"><c:out value="${n.fecha}" /> · Hora de Bogotá</p><div class="acciones-documento"><c:if test="${not empty n.proyecto_id}"><a class="boton" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${n.proyecto_id}' /></c:url>">Ver proyecto →</a></c:if><c:if test="${empty n.leido_en}"><form method="post" action="<c:url value='/acciones/aviso-leer.jsp' />"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${n.id}"><button class="boton" type="submit">Marcar como leído</button></form></c:if></div></article></c:forEach>
<nav class="paginacion" aria-label="Páginas de avisos"><c:if test="${pagina gt 1}"><a class="boton" href="<c:url value='/avisos.jsp'><c:param name='pagina' value='${pagina-1}' /></c:url>">← Anterior</a></c:if><span class="dato-secundario">Página <c:out value="${pagina}" /></span><c:if test="${notificaciones.rowCount gt 20}"><a class="boton" href="<c:url value='/avisos.jsp'><c:param name='pagina' value='${pagina+1}' /></c:url>">Siguiente →</a></c:if></nav><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
