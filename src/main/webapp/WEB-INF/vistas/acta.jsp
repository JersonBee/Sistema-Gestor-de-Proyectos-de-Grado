<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<article class="tarjeta documento-acta"><p class="sobretitulo">UNIDADES TECNOLÓGICAS DE SANTANDER · COMITÉ DE PROYECTOS</p><h1>Acta <c:out value="${acta.numero}" /></h1><p class="dato-secundario">Fecha: <c:out value="${acta.fecha}" /> · ${empty acta.aprobada_en ? 'Pendiente de aprobación' : 'Aprobada'}</p><h2>Descripción</h2><p class="texto-largo"><c:out value="${acta.descripcion}" /></p><h2>Detalles y decisiones</h2><p class="texto-largo"><c:out value="${acta.detalles}" /></p><h2>Proyectos vinculados</h2><c:forEach items="${vinculosActa.rows}" var="p"><p><a href="<c:url value='/actas.jsp'><c:param name='id' value='${p.id}' /></c:url>"><c:out value="${p.titulo}" /></a></p></c:forEach><p class="dato-secundario">Registrada por <c:out value="${acta.creada_por}" /></p><c:if test="${not empty acta.aprobada_en}"><p class="dato-secundario">Aprobada por <c:out value="${acta.aprobada_por}" /> · <c:out value="${acta.aprobacion}" /> · Hora de Bogotá</p></c:if></article>
<p class="dato-secundario no-imprimir">Puedes usar la opción Imprimir del navegador para guardar o imprimir el acta.</p><c:if test="${usuarioActual.rol_codigo eq 'comite' and empty acta.aprobada_en}"><form class="tarjeta formulario no-imprimir" method="post" action="<c:url value='/acciones/acta-aprobar.jsp' />"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="acta" value="${acta.id}"><p class="dato-secundario">La aprobación conserva el contenido del acta y la hace visible a quienes tienen acceso al proyecto.</p><button class="boton primario" type="submit">Aprobar acta</button></form></c:if><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
