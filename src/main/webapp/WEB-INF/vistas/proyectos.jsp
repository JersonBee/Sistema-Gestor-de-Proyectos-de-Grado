<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %><section class="bienvenida-panel"><div><p class="sobretitulo">CONSULTA Y SEGUIMIENTO</p><h1>Proyectos.</h1><p>Busca por participantes, docentes y avance del proceso.</p></div></section>
<form class="tarjeta formulario" method="get"><div class="rejilla-formulario"><div class="campo"><label for="q">Título o número de proyecto</label><input id="q" name="q" value="<c:out value='${param.q}' />" maxlength="200"></div><div class="campo"><label for="estudiante">Estudiante · Nombre o correo</label><input id="estudiante" name="estudiante" value="<c:out value='${param.estudiante}' />" maxlength="200"></div><div class="campo"><label for="director">Director</label><input id="director" name="director" value="<c:out value='${param.director}' />" maxlength="200"></div><div class="campo"><label for="evaluador">Evaluador</label><input id="evaluador" name="evaluador" value="<c:out value='${param.evaluador}' />" maxlength="200"></div><div class="campo"><label for="modalidad">Modalidad</label><select id="modalidad" name="modalidad"><option value="">Todas</option><c:forEach items="${modalidades.rows}" var="m"><option value="${m.id}" ${param.modalidad eq m.id ? 'selected' : ''}><c:out value="${m.nombre}" /></option></c:forEach></select></div><div class="campo"><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><c:forTokens items="activo,desactivado,cancelado,finalizado" delims="," var="e"><option value="${e}" ${param.estado eq e ? 'selected' : ''}><c:out value="${e}" /></option></c:forTokens></select></div><div class="campo"><label for="fase">Fase actual o de cierre</label><select id="fase" name="fase"><option value="">Todas</option><c:forEach items="${fases.rows}" var="f"><option value="${f.codigo}" ${param.fase eq f.codigo ? 'selected' : ''}><c:out value="${f.nombre}" /></option></c:forEach></select></div><div class="campo"><label for="desde">Creado desde</label><input type="date" id="desde" name="desde" value="<c:out value='${param.desde}' />"><label for="hasta">Creado hasta</label><input type="date" id="hasta" name="hasta" value="<c:out value='${param.hasta}' />"></div></div><div class="acciones-documento"><button class="boton primario" type="submit">Buscar proyectos</button><a class="boton" href="<c:url value='/proyectos.jsp' />">Limpiar filtros</a></div></form>
<c:if test="${not empty falloBusqueda}"><p class="aviso error">No se pudo completar la búsqueda. Revisa las fechas y vuelve a intentarlo.</p></c:if><section class="tarjeta"><h2>Resultados</h2><c:if test="${empty lista.rows and empty falloBusqueda}"><p class="dato-secundario">No hay proyectos que coincidan con estos filtros.</p></c:if><c:forEach items="${lista.rows}" var="p" end="19"><article class="fila-proyecto"><div><p class="identificador">PROYECTO #<c:out value="${p.id}" /> · <c:out value="${p.fecha}" /></p><h3><a href="<c:url value='/proyecto.jsp'><c:param name='id' value='${p.id}' /></c:url>"><c:out value="${p.titulo}" /></a></h3><p class="dato-secundario"><c:out value="${p.modalidad}" /></p></div><div class="estado-proyecto"><span class="insignia"><c:out value="${p.estado}" /></span><span class="dato-secundario"><c:out value="${p.fase}" /></span></div></article></c:forEach></section>
<nav class="paginacion" aria-label="Páginas de proyectos"><c:if test="${pagina gt 1}"><a class="boton" href="<c:url value='/proyectos.jsp'><c:param name='pagina' value='${pagina-1}' /><c:forTokens items='q,estudiante,director,evaluador,modalidad,estado,fase,desde,hasta' delims=',' var='filtro'><c:param name='${filtro}' value='${param[filtro]}' /></c:forTokens></c:url>">← Anterior</a></c:if><span class="dato-secundario">Página <c:out value="${pagina}" /></span><c:if test="${lista.rowCount gt 20}"><a class="boton" href="<c:url value='/proyectos.jsp'><c:param name='pagina' value='${pagina+1}' /><c:forTokens items='q,estudiante,director,evaluador,modalidad,estado,fase,desde,hasta' delims=',' var='filtro'><c:param name='${filtro}' value='${param[filtro]}' /></c:forTokens></c:url>">Siguiente →</a></c:if></nav><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
