<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<%@ include file="/WEB-INF/vistas/comun/inicio-bienvenida.jsp" %>
<%@ include file="/WEB-INF/vistas/comun/inicio-accesos.jsp" %>
<h2 class="titulo-seguimiento-inicio">Seguimiento general</h2>
<section class="tarjeta"><div class="titulo-tarjeta"><h2>Mis tareas</h2><a href="<c:url value='/tareas.jsp' />">Ver todas →</a></div><%@ include file="/WEB-INF/vistas/comun/lista-tareas.jsp" %></section>
<div class="columnas-panel"><section class="tarjeta proyectos-panel"><header class="titulo-tarjeta"><h2>Mis proyectos</h2><span class="contador"><c:out value="${proyectos.rowCount}" /></span></header>
    <c:choose><c:when test="${empty proyectos.rows}"><div class="estado-vacio"><span class="icono-vacio" aria-hidden="true">↗</span><h3>Todo empieza con una idea</h3><p>Aún no tienes proyectos registrados. Aquí encontrarás su fase y sus entregas cuando se cree o se te asigne un proyecto.</p></div></c:when><c:otherwise><div class="lista-proyectos"><c:forEach items="${proyectos.rows}" var="proyecto"><article class="fila-proyecto"><div><p class="identificador">PROYECTO #<c:out value="${proyecto.id}" /></p><h3><a href="<c:url value='/proyecto.jsp'><c:param name='id' value='${proyecto.id}' /></c:url>"><c:out value="${proyecto.titulo}" /></a></h3><p class="dato-secundario"><c:out value="${proyecto.modalidad}" /></p></div><div class="estado-proyecto"><span class="insignia"><c:out value="${proyecto.estado}" /></span><span class="dato-secundario"><c:out value="${proyecto.fase}" /></span></div></article></c:forEach></div></c:otherwise></c:choose>
</section><aside class="tarjeta avisos-panel"><header class="titulo-tarjeta"><h2>Mis avisos</h2><span class="indicador-verde" aria-hidden="true"></span></header><c:choose><c:when test="${empty avisos.rows}"><p class="sin-avisos">Estás al día.</p><p class="dato-secundario">Aquí verás novedades de tus entregas y solicitudes.</p></c:when><c:otherwise><c:forEach items="${avisos.rows}" var="aviso"><article class="aviso-panel"><h3><c:out value="${aviso.asunto}" /></h3><p><c:out value="${aviso.cuerpo}" /></p></article></c:forEach></c:otherwise></c:choose></aside></div>
<section class="tarjeta recorrido-panel"><div class="titulo-tarjeta"><h2>El recorrido del proyecto</h2><span class="dato-secundario">De la idea al cierre</span></div><ol class="fases"><c:forTokens items="Pago,Propuesta I,Propuesta II,Informe I,Informe II,Final" delims="," var="fase" varStatus="paso"><li><span class="numero"><c:out value="${paso.count}" /></span><span><c:out value="${fase}" /></span></li></c:forTokens></ol></section>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
