<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a><section class="bienvenida-panel"><div><p class="sobretitulo">FASE 6 · FINAL</p><h1 class="titulo-proyecto"><c:out value="${proyectoVista.titulo}" /></h1><p>Entregables complementarios y cierre del proyecto.</p></div><span class="etiqueta-rol"><c:out value="${proyectoVista.estado}" /></span></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${not proyectoVista.fase_final}"><p class="aviso">Esta fase se habilitará cuando el Comité apruebe el informe.</p></c:if>
<c:if test="${proyectoVista.estado eq 'finalizado'}"><p class="aviso exito">Proyecto finalizado por <c:out value="${proyectoVista.finalizado_por}" />. Su historial permanece disponible para consulta.</p></c:if>
<section class="tarjeta"><h2>Datos finales</h2><p class="dato-secundario">Manual, licencia, evidencia y repositorio son opcionales. Se registran cuando se requieren para el proyecto.</p><dl class="lista-datos"><dt>Licencia</dt><dd><c:out value="${datosFinales.rows[0].tipo_licencia}" default="Sin registrar" /></dd><dt>Repositorio</dt><dd><c:choose><c:when test="${not empty datosFinales.rows[0].repositorio_url}"><a href="<c:out value='${datosFinales.rows[0].repositorio_url}' />" target="_blank" rel="noopener noreferrer">Abrir repositorio ↗</a><p class="dato-secundario">Registrado por <c:out value="${datosFinales.rows[0].director}" /> · <c:out value="${datosFinales.rows[0].fecha}" /></p></c:when><c:otherwise>Sin registrar</c:otherwise></c:choose></dd></dl></section>
<c:if test="${proyectoVista.estado eq 'activo' and proyectoVista.fase_final and (proyectoVista.integrante or proyectoVista.es_director)}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/final-guardar.jsp' />"><h2>Registrar o actualizar un entregable</h2><p class="dato-secundario">Los enlaces anteriores se conservan en el historial.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><label for="campo">Dato a registrar</label><select id="campo" name="campo" required><c:if test="${proyectoVista.integrante}"><option value="manual_usuario">Manual de usuario · Enlace</option><option value="evidencia_publicacion">Evidencia de publicación · Enlace</option><option value="licencia">Tipo de licencia · Texto</option></c:if><c:if test="${proyectoVista.es_director}"><option value="repositorio">Repositorio · Enlace</option></c:if></select><label for="valor">Valor o enlace</label><textarea id="valor" name="valor" rows="3" maxlength="8000" required></textarea><p class="ayuda">Para documentos y repositorio usa un enlace http:// o https://. Para licencia escribe su nombre.</p><button class="boton primario" type="submit">Guardar entregable</button></form></c:if>
<c:if test="${usuarioActual.rol_codigo eq 'comite' and proyectoVista.estado eq 'activo' and proyectoVista.fase_final}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/final-cerrar.jsp' />"><h2>Finalizar proyecto</h2><p class="dato-secundario">Los entregables opcionales no bloquean el cierre. Al finalizar se cierran las participaciones, las asignaciones y las solicitudes pendientes; estas últimas quedan atendidas sin aplicar cambios. El proyecto conservará su idea y su historial.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><label for="nota">Observaciones de cierre <span>(opcional)</span></label><textarea id="nota" name="nota" rows="3" maxlength="12000"></textarea><button class="boton primario" type="submit">Aprobar cierre y finalizar proyecto</button></form></c:if>
<section class="tarjeta historial"><h2>Documentos finales y sus versiones</h2><c:if test="${empty documentosFinales.rows}"><p class="dato-secundario">Todavía no hay documentos finales registrados.</p></c:if><c:forEach items="${documentosFinales.rows}" var="d"><article><h3><c:out value="${d.nombre}" /> · Versión <c:out value="${d.numero}" /></h3><p class="dato-secundario"><c:out value="${d.fecha}" /> · <c:out value="${d.autor}" /></p><div class="acciones-documento"><a href="<c:url value='/documento.jsp'><c:param name='version' value='${d.version_id}' /></c:url>">Previsualizar</a><a href="<c:out value='${d.url}' />" target="_blank" rel="noopener noreferrer">Abrir enlace ↗</a></div></article></c:forEach><a class="enlace-texto" href="<c:url value='/historial.jsp'><c:param name='id' value='${param.id}' /></c:url>">Consultar el historial completo →</a></section>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
