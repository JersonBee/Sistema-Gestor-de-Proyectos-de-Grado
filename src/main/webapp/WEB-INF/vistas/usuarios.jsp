<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %><section class="bienvenida-panel"><div><p class="sobretitulo">ADMINISTRACIÓN DEL COMITÉ</p><h1>Cuentas.</h1><p>Consulta usuarios y administra su único rol y estado de acceso.</p></div></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %><form class="barra-filtros" method="get"><label class="campo">Nombre o correo<input name="q" value="<c:out value='${param.q}' />" maxlength="200"></label><button class="boton primario" type="submit">Buscar</button></form><section class="tarjeta"><c:if test="${empty cuentas.rows}"><p class="dato-secundario">No se encontraron cuentas.</p></c:if><c:forEach items="${cuentas.rows}" var="u" end="19"><article class="fila-proyecto"><div><h3><a href="<c:url value='/usuario.jsp'><c:param name='usuario' value='${u.id}' /></c:url>"><c:out value="${u.nombre}" /></a></h3><p class="dato-secundario"><c:out value="${u.correo}" /> · <c:out value="${u.rol}" /></p></div><span class="insignia"><c:out value="${u.estado}" /></span></article></c:forEach></section><nav class="paginacion" aria-label="Páginas de cuentas"><c:if test="${pagina gt 1}"><a class="boton" href="<c:url value='/usuarios.jsp'><c:param name='pagina' value='${pagina-1}' /><c:param name='q' value='${param.q}' /></c:url>">← Anterior</a></c:if><span class="dato-secundario">Página <c:out value="${pagina}" /></span><c:if test="${cuentas.rowCount gt 20}"><a class="boton" href="<c:url value='/usuarios.jsp'><c:param name='pagina' value='${pagina+1}' /><c:param name='q' value='${param.q}' /></c:url>">Siguiente →</a></c:if></nav><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
