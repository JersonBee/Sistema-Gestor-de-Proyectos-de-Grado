<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a><section class="bienvenida-panel"><div><p class="sobretitulo">FASE 1 · PAGO</p><h1 class="titulo-proyecto"><c:out value="${pago.titulo}" /></h1><p>Presenta y consulta el conjunto de documentos para iniciar el proyecto.</p></div><span class="etiqueta-rol"><c:out value="${not empty pago.aprobado_en ? 'Pago aprobado' : (not empty ultimaEntrega and empty ultimaEntrega.finalizado_en ? 'En revisión' : 'Pendiente de envío')}" /></span></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${pago.estado ne 'activo'}"><p class="aviso">El proyecto no está activo. Sus procedimientos están detenidos.</p></c:if>
<section class="tarjeta"><h2>Participantes presentados</h2><div class="rejilla-ideas"><c:forEach items="${participantesPago.rows}" var="p"><article><h3><c:out value="${p.nombre_en_pago}" /></h3><p class="dato-secundario"><c:out value="${p.correo_en_pago}" /><br>Documento: <c:out value="${p.documento_en_pago}" default="Sin registrar" /><br>Teléfono: <c:out value="${p.telefono_en_pago}" default="Sin registrar" /></p></article></c:forEach></div><p class="dato-secundario">Director propuesto: <c:out value="${pago.director_propuesto}" default="Sin preferencia" /></p></section>
<c:if test="${pago.estado eq 'activo' and pago.integrante and usuarioActual.rol_codigo eq 'estudiante' and empty pago.aprobado_en and (empty ultimaEntrega or not empty ultimaEntrega.finalizado_en)}">
 <form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/pago-enviar.jsp' />"><h2><c:out value="${empty ultimaEntrega ? 'Presentar documentos' : 'Reenviar el conjunto corregido'}" /></h2><p class="dato-secundario">El Comité revisa el conjunto completo. En cada envío incluye nuevamente el comprobante y todos los adicionales que deban revisarse.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${pago.id}"><label for="comprobante">Enlace del comprobante de pago</label><input id="comprobante" name="comprobante" type="url" required maxlength="8000" placeholder="https://..."><label for="adicionales">Enlaces adicionales <span>(opcionales, uno por línea)</span></label><textarea id="adicionales" name="adicionales" rows="4" maxlength="48000" placeholder="https://..."></textarea><p class="ayuda">Comprueba que los enlaces permiten consultar los documentos.</p><button class="boton primario" type="submit">Enviar conjunto al Comité →</button></form>
</c:if>
<c:if test="${pago.estado eq 'activo' and usuarioActual.rol_codigo eq 'comite' and not empty ultimaEntrega and empty ultimaEntrega.finalizado_en}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/pago-decidir.jsp' />"><h2>Decidir sobre la entrega #<c:out value="${ultimaEntrega.numero}" /></h2><p class="dato-secundario">Revisa todos los enlaces de esta entrega antes de guardar la decisión.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${pago.id}"><input type="hidden" name="entrega" value="${ultimaEntrega.id}"><label for="decision">Decisión del conjunto</label><select id="decision" name="decision" required><option value="">Selecciona</option><option value="aprobado">Aprobar conjunto</option><option value="rechazado">Solicitar corrección</option></select><label for="reporte">Reporte para el estudiante</label><textarea id="reporte" name="reporte" rows="4" maxlength="12000" required></textarea><button class="boton primario" type="submit">Guardar decisión</button></form></c:if>
<c:if test="${pago.estado eq 'activo' and usuarioActual.rol_codigo eq 'comite' and not empty pago.aprobado_en and empty pago.finalizada_en}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/docentes-asignar.jsp' />"><h2>Asignar docentes</h2><p class="dato-secundario">Los perfiles mostrados coinciden en modalidad, área y línea. Al asignar ambos docentes, el proyecto avanzará a Propuesta I.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${pago.id}"><label for="director">Director</label><select id="director" name="director" required><option value="">Selecciona un director</option><c:forEach items="${aptos.rows}" var="d"><c:if test="${d.rol_codigo eq 'director'}"><option value="${d.id}"><c:out value="${d.nombre}" /></option></c:if></c:forEach></select><label for="evaluador">Evaluador</label><select id="evaluador" name="evaluador" required><option value="">Selecciona un evaluador</option><c:forEach items="${aptos.rows}" var="d"><c:if test="${d.rol_codigo eq 'evaluador'}"><option value="${d.id}"><c:out value="${d.nombre}" /></option></c:if></c:forEach></select><button class="boton primario" type="submit">Asignar y comenzar Propuesta I →</button></form></c:if>
<section class="tarjeta historial"><h2>Historial de entregas</h2><c:if test="${empty entregas.rows}"><p class="dato-secundario">Aún no se han presentado documentos.</p></c:if><c:forEach items="${entregas.rows}" var="e"><article><div class="titulo-tarjeta"><h3>Entrega #<c:out value="${e.numero}" /></h3><span class="insignia"><c:out value="${e.decision}" default="En revisión" /></span></div><p class="dato-secundario"><c:out value="${e.fecha}" /> · Hora de Bogotá</p><ul class="lista-documentos"><c:forEach items="${adjuntos.rows}" var="a"><c:if test="${a.entrega_id eq e.id}"><li><a href="<c:out value='${a.url}' />" target="_blank" rel="noopener noreferrer"><c:out value="${empty a.etiqueta ? a.nombre : a.etiqueta}" /> ↗</a><span class="url-documento"><c:out value="${a.url}" /></span></li></c:if></c:forEach></ul><c:if test="${not empty e.decision}"><p class="dato-secundario">Reporte de <c:out value="${e.responsable}" /></p><p class="texto-largo"><c:out value="${e.reporte_respuesta}" /></p></c:if></article></c:forEach></section>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
