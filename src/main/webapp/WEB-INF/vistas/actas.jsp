<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a><section class="bienvenida-panel"><div><p class="sobretitulo">REGISTRO DEL COMITÉ</p><h1 class="titulo-proyecto"><c:out value="${proyectoVista.titulo}" /></h1><p>Actas y decisiones formales vinculadas al proyecto.</p></div></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${usuarioActual.rol_codigo eq 'comite' and proyectoVista.estado ne 'desactivado'}"><details class="tarjeta seccion-desplegable"><summary>Registrar un acta nueva</summary><form class="formulario" method="post" action="<c:url value='/acciones/acta-crear.jsp' />"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><div class="rejilla-formulario"><div class="campo"><label for="numero">Número del acta</label><input id="numero" name="numero" maxlength="100" required></div><div class="campo"><label for="fecha">Fecha</label><input id="fecha" name="fecha" type="date" required></div></div><label for="descripcion">Descripción</label><textarea id="descripcion" name="descripcion" rows="2" maxlength="4000" required></textarea><label for="detalles">Detalles y decisiones</label><textarea id="detalles" name="detalles" rows="6" maxlength="20000" required></textarea><p class="dato-secundario">Se guardará pendiente de aprobación. Los demás usuarios podrán consultarla cuando el Comité la apruebe.</p><button class="boton primario" type="submit">Registrar acta</button></form></details></c:if>
<c:if test="${empty actas.rows}"><section class="tarjeta estado-vacio"><h2>No hay actas disponibles</h2><p>Las actas aprobadas aparecerán aquí.</p></section></c:if><c:forEach items="${actas.rows}" var="a"><article class="tarjeta"><div class="titulo-tarjeta"><h2>Acta <c:out value="${a.numero}" /></h2><span class="insignia">${empty a.aprobada_en ? 'Pendiente de aprobación' : 'Aprobada'}</span></div><p class="dato-secundario"><c:out value="${a.fecha}" /></p><p class="texto-largo"><c:out value="${a.descripcion}" /></p><a class="boton" href="<c:url value='/acta.jsp'><c:param name='acta' value='${a.id}' /></c:url>">Consultar acta →</a></article></c:forEach><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
