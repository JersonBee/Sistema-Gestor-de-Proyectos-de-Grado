<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a><section class="bienvenida-panel"><div><p class="sobretitulo">TRÁMITES DEL PROYECTO</p><h1 class="titulo-proyecto"><c:out value="${proyectoVista.titulo}" /></h1><p>Solicitudes, preferencias y respuestas del Comité.</p></div><span class="etiqueta-rol"><c:out value="${proyectoVista.estado}" /></span></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${proyectoVista.estado ne 'activo'}"><p class="aviso">El proyecto no está activo. Las solicitudes permanecen disponibles para consulta.</p></c:if>
<c:if test="${proyectoVista.integrante and proyectoVista.estado eq 'activo' and usuarioActual.rol_codigo eq 'estudiante'}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/solicitud-crear.jsp' />"><h2>Enviar una solicitud</h2><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><label for="tipo">Tipo de solicitud</label><select id="tipo" name="tipo" required><option value="solicitud">Solicitud general</option><option value="cambio_director">Cambio de director</option><option value="cambio_evaluador">Cambio de evaluador</option><option value="retiro">Mi retiro del proyecto</option><option value="reclamo">Reclamo</option><option value="queja">Queja</option></select><label for="preferido">Docente preferido <span>(solo para cambios de docente)</span></label><select id="preferido" name="preferido"><option value="">No corresponde</option><c:forEach items="${aptos.rows}" var="d"><option value="${d.id}"><c:out value="${d.nombre}" /> · <c:out value="${d.rol_codigo}" /></option></c:forEach></select><p class="ayuda">Para un cambio, selecciona un docente apto del rol correspondiente. El Comité debe aprobarlo.</p><label for="descripcion">Motivo y detalles</label><textarea id="descripcion" name="descripcion" rows="4" maxlength="12000" required></textarea><p class="dato-secundario">El retiro solicitado corresponde únicamente a tu participación. Si el Comité lo aprueba y queda otro integrante, el proyecto continúa; si eres el último, se cancela y la idea vuelve al banco.</p><button class="boton primario" type="submit">Enviar al Comité →</button></form></c:if>
<section class="tarjeta historial"><h2>Solicitudes y respuestas</h2><c:if test="${empty solicitudes.rows}"><p class="dato-secundario">Todavía no hay solicitudes registradas.</p></c:if><c:forEach items="${solicitudes.rows}" var="s" end="19"><article><div class="titulo-tarjeta"><h3><c:out value="${fn:replace(s.tipo,'_',' ')}" /></h3><span class="insignia"><c:out value="${s.estado}" /></span></div><p class="dato-secundario"><c:out value="${s.fecha}" /> · <c:out value="${s.solicitante}" /></p><p class="texto-largo"><c:out value="${s.descripcion}" /></p><c:if test="${not empty s.preferido}"><p class="dato-secundario">Docente preferido: <c:out value="${s.preferido}" /></p></c:if><c:if test="${not empty s.respuesta}"><div class="aviso"><strong>Respuesta</strong><p class="texto-largo"><c:out value="${s.respuesta}" /></p></div></c:if>
<c:if test="${usuarioActual.rol_codigo eq 'comite' and proyectoVista.estado eq 'activo' and s.estado eq 'pendiente'}"><form class="formulario" method="post" action="<c:url value='/acciones/solicitud-decidir.jsp' />"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><input type="hidden" name="solicitud" value="${s.id}"><label for="decision-${s.id}">Decisión</label><select id="decision-${s.id}" name="decision" required><option value="">Selecciona</option><c:choose><c:when test="${s.tipo eq 'retiro' or s.tipo eq 'cambio_director' or s.tipo eq 'cambio_evaluador'}"><option value="aprobada">Aprobar y aplicar</option></c:when><c:otherwise><option value="atendida">Marcar como atendida</option></c:otherwise></c:choose><option value="rechazada">Rechazar</option></select><label for="respuesta-${s.id}">Respuesta del Comité</label><textarea id="respuesta-${s.id}" name="respuesta" required maxlength="12000" rows="3"></textarea><button class="boton primario" type="submit">Guardar respuesta</button></form></c:if></article></c:forEach></section>
<nav class="paginacion" aria-label="Páginas de solicitudes"><c:if test="${pagina gt 1}"><a class="boton" href="<c:url value='/solicitudes.jsp'><c:param name='id' value='${param.id}' /><c:param name='pagina' value='${pagina-1}' /></c:url>">← Anterior</a></c:if><span class="dato-secundario">Página <c:out value="${pagina}" /></span><c:if test="${solicitudes.rowCount gt 20}"><a class="boton" href="<c:url value='/solicitudes.jsp'><c:param name='id' value='${param.id}' /><c:param name='pagina' value='${pagina+1}' /></c:url>">Siguiente →</a></c:if></nav><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
