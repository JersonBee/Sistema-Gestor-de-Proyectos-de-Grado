<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<section class="bienvenida-panel"><div><p class="sobretitulo">INFORMACIÓN PERSONAL</p><h1>Mi cuenta<span class="saludo-punto">.</span></h1><p>Los datos asociados a tu participación en el sistema.</p></div><span class="etiqueta-rol"><c:out value="${nombreRol}" /></span></section>
<section class="tarjeta detalle-cuenta"><h2>Datos de tu cuenta</h2><dl class="lista-datos"><dt>Nombres y apellidos</dt><dd><c:out value="${cuenta.rows[0].nombre}" /></dd><dt>Correo electrónico</dt><dd><c:out value="${cuenta.rows[0].correo}" /></dd><dt>Documento</dt><dd><c:out value="${cuenta.rows[0].numero_documento}" default="Sin registrar" /></dd><dt>Teléfono</dt><dd><c:out value="${cuenta.rows[0].telefono}" default="Sin registrar" /></dd><dt>Rol</dt><dd><c:out value="${nombreRol}" /></dd></dl></section>
<c:if test="${not empty perfil.rows}"><section class="tarjeta detalle-cuenta"><h2>Perfil docente</h2><dl class="lista-datos"><dt>Áreas de experiencia</dt><dd><c:out value="${perfil.rows[0].areas}" /></dd><dt>Líneas de investigación</dt><dd><c:out value="${perfil.rows[0].lineas}" /></dd><dt>Cursos</dt><dd><c:out value="${perfil.rows[0].cursos}" /></dd><dt>Títulos académicos</dt><dd><c:out value="${perfil.rows[0].titulos_academicos}" /></dd><dt>Temas de preferencia</dt><dd><c:out value="${perfil.rows[0].temas_preferencia}" /></dd><dt>Modalidades</dt><dd><c:out value="${perfil.rows[0].modalidades}" /></dd></dl></section></c:if>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
