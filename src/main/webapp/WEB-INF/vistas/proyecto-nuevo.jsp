<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/idea.jsp'><c:param name='id' value='${param.idea}' /></c:url>">← Volver a la idea</a><section class="bienvenida-panel"><div><p class="sobretitulo">FASE 1 · PAGO</p><h1>Tu proyecto empieza aquí.</h1><p><c:out value="${seleccion.rows[0].titulo}" /></p></div></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/proyecto-crear.jsp' />"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="idea" value="${param.idea}">
 <h2>Primer participante · Tú</h2><p class="dato-secundario">Confirma los datos que presentarás en la fase Pago.</p><label for="nombre">Nombres y apellidos</label><input id="nombre" name="nombre" value="<c:out value='${cuenta.rows[0].nombre}' />" maxlength="120" required><p class="ayuda">Correo de tu cuenta: <c:out value="${cuenta.rows[0].correo}" /></p>
 <div class="rejilla-formulario"><div class="campo"><label for="documento">Documento <span>(opcional)</span></label><input id="documento" name="documento" maxlength="40" value="<c:out value='${cuenta.rows[0].numero_documento}' />"></div><div class="campo"><label for="telefono">Teléfono <span>(opcional)</span></label><input id="telefono" name="telefono" maxlength="40" value="<c:out value='${cuenta.rows[0].telefono}' />"></div></div>
 <details class="seccion-desplegable"><summary>Agregar segundo participante · Opcional</summary><p class="dato-secundario">Debe tener una cuenta estudiantil activa y no pertenecer a otro proyecto. Deja este apartado vacío para un proyecto individual.</p><label for="pareja_correo">Correo de su cuenta</label><input id="pareja_correo" name="pareja_correo" type="email" maxlength="254"><label for="pareja_nombre">Nombres y apellidos</label><input id="pareja_nombre" name="pareja_nombre" maxlength="120"><div class="rejilla-formulario"><div class="campo"><label for="pareja_documento">Documento <span>(opcional)</span></label><input id="pareja_documento" name="pareja_documento" maxlength="40"></div><div class="campo"><label for="pareja_telefono">Teléfono <span>(opcional)</span></label><input id="pareja_telefono" name="pareja_telefono" maxlength="40"></div></div></details>
 <label for="director">Director propuesto <span>(opcional)</span></label><select id="director" name="director"><option value="">Sin preferencia</option><c:forEach items="${directores.rows}" var="d"><option value="${d.id}"><c:out value="${d.nombre}" /></option></c:forEach></select><p class="ayuda">El Comité hará la asignación de director y evaluador después de aprobar el pago.</p><button class="boton primario" type="submit">Reservar idea y continuar al pago →</button>
</form><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
