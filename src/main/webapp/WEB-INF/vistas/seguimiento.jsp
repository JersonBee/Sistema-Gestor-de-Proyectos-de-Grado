<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %>
<a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a><section class="bienvenida-panel"><div><p class="sobretitulo">SEGUIMIENTO DOCUMENTAL · <c:out value="${tituloPagina}" /></p><h1 class="titulo-proyecto"><c:out value="${proyecto.titulo}" /></h1><p>Entrega, revisión y respuesta sobre el mismo conjunto de documentos.</p></div><span class="etiqueta-rol"><c:out value="${proyecto.estado}" /></span></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<section class="tarjeta"><h2>El siguiente paso</h2><c:choose><c:when test="${proyecto.estado ne 'activo'}"><p class="dato-secundario">El proyecto está <c:out value="${proyecto.estado}" />. Puedes consultar su historial.</p></c:when><c:when test="${not empty pendiente}"><p class="texto-largo">En revisión por <strong><c:out value="${pendiente.responsable}" /></strong> · <c:out value="${pendiente.etapa}" /></p><c:if test="${not empty pendiente.limite}"><p class="dato-secundario">Plazo de revisión: <c:out value="${pendiente.limite}" /> · Hora de Bogotá</p></c:if></c:when><c:when test="${empty proyecto.fase_id}"><p class="dato-secundario">Esta fase todavía no ha comenzado.</p></c:when><c:when test="${not empty proyecto.finalizada_en}"><p class="dato-secundario">Este recorrido ya fue aprobado. Continúa en la siguiente fase del proyecto.</p></c:when><c:when test="${param.tipo eq 'informe' and not proyecto.informe_disponible}"><p class="dato-secundario">Espera de Informe I: podrás presentar los documentos a partir de <c:out value="${proyecto.habilitado}" />.</p></c:when><c:otherwise><p class="dato-secundario">El estudiante debe presentar el conjunto completo a su director.</p></c:otherwise></c:choose>
<c:if test="${not empty correcciones.rows}"><c:choose>
<c:when test="${proyecto.estado eq 'activo'}"><p class="aviso">Plazo de corrección: <c:out value="${correcciones.rows[0].limite}" />. Si se supera, recibirás una alerta y podrás reenviar.</p></c:when>
<c:when test="${proyecto.estado eq 'desactivado'}"><p class="dato-secundario">La corrección está suspendida durante la pausa. Su plazo se ajustará al reanudar el proyecto.</p></c:when>
<c:otherwise><p class="dato-secundario">Plazo de corrección registrado: <c:out value="${correcciones.rows[0].limite}" />. Es una referencia histórica; el proceso está cerrado.</p></c:otherwise>
</c:choose></c:if>
<c:if test="${param.tipo eq 'informe' and not empty proyecto.vence}"><p class="dato-secundario"><c:choose><c:when test="${not empty proyecto.informe_aprobado_comite_en}">El Comité aprobó el informe. La cancelación por plazo está detenida.</c:when><c:otherwise>Vigencia del proyecto hasta <c:out value="${proyecto.vence}" /> · Hora de Bogotá.</c:otherwise></c:choose></p></c:if></section>
<c:if test="${not empty entregas.rows}"><section class="tarjeta"><div class="titulo-tarjeta"><h2>Documentos de la última entrega</h2><span class="insignia">Entrega #<c:out value="${entregas.rows[0].numero}" /></span></div><ul class="lista-documentos documentos-actuales"><c:forEach items="${adjuntos.rows}" var="a"><c:if test="${a.entrega_id eq entregas.rows[0].id}"><li><strong><c:out value="${empty a.etiqueta ? a.nombre : a.etiqueta}" /></strong><div class="acciones-documento"><a href="<c:url value='/documento.jsp'><c:param name='version' value='${a.version_id}' /></c:url>">Previsualizar</a><a href="<c:out value='${a.url}' />" target="_blank" rel="noopener noreferrer">Abrir enlace ↗</a></div></li></c:if></c:forEach></ul></section></c:if>
<c:if test="${proyecto.estado eq 'activo' and usuarioActual.rol_codigo eq 'estudiante' and proyecto.integrante and not empty proyecto.fase_id and empty proyecto.finalizada_en and empty pendiente and (param.tipo eq 'propuesta' or proyecto.informe_disponible)}">
<form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/documentos-enviar.jsp' />"><h2>Presentar <c:out value="${tituloPagina}" /></h2><p class="dato-secundario">Incluye todos los documentos en cada envío. Después de una corrección o vencimiento, el conjunto vuelve a comenzar por el director.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${proyecto.id}"><input type="hidden" name="tipo" value="<c:out value='${param.tipo}' />">
<c:choose><c:when test="${param.tipo eq 'propuesta'}"><label for="f_dc_124">Enlace F-DC-124</label><input type="url" id="f_dc_124" name="f_dc_124" required maxlength="8000" placeholder="https://..."></c:when><c:otherwise><label for="f_dc_125">Enlace F-DC-125</label><input type="url" id="f_dc_125" name="f_dc_125" required maxlength="8000" placeholder="https://..."><label for="f_dc_129">Enlace F-DC-129</label><input type="url" id="f_dc_129" name="f_dc_129" required maxlength="8000" placeholder="https://..."></c:otherwise></c:choose>
<label for="turnitin">Enlace del reporte Turnitin</label><input type="url" id="turnitin" name="turnitin" required maxlength="8000" placeholder="https://..."><label for="adicionales">Enlaces adicionales <span>(opcionales, uno por línea)</span></label><textarea id="adicionales" name="adicionales" rows="4" maxlength="48000"></textarea><button class="boton primario" type="submit">Enviar conjunto al director →</button></form></c:if>
<c:if test="${proyecto.estado eq 'activo' and not empty pendiente and usuarioActual.rol_codigo eq pendiente.etapa and (pendiente.etapa eq 'comite' or pendiente.responsable_id eq usuarioActual.id)}"><form class="tarjeta formulario detalle-cuenta" method="post" action="<c:url value='/acciones/revision-decidir.jsp' />"><h2>Tu revisión · <c:out value="${nombreRol}" /></h2><p class="dato-secundario">Consulta los documentos de la última entrega antes de decidir. El reporte es obligatorio al aprobar o rechazar.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${proyecto.id}"><input type="hidden" name="tipo" value="<c:out value='${param.tipo}' />"><input type="hidden" name="revision" value="${pendiente.id}"><label for="decision">Decisión del conjunto</label><select id="decision" name="decision" required><option value="">Selecciona</option><option value="aprobado">Aprobar conjunto</option><option value="rechazado">Solicitar correcciones</option></select><label for="reporte">Reporte de respuesta</label><textarea id="reporte" name="reporte" rows="4" required maxlength="12000"></textarea><button class="boton primario" type="submit">Guardar revisión</button></form></c:if>
<section class="tarjeta historial"><h2>Entregas y revisiones</h2><c:if test="${empty entregas.rows}"><p class="dato-secundario">Todavía no hay entregas en este recorrido.</p></c:if><c:forEach items="${entregas.rows}" var="e"><article><div class="titulo-tarjeta"><h3>Entrega #<c:out value="${e.numero}" /></h3><span class="insignia"><c:out value="${empty e.finalizado_en ? 'En revisión' : 'Ciclo terminado'}" /></span></div><p class="dato-secundario"><c:out value="${e.fecha}" /> · <c:out value="${e.autor}" /></p><ul class="lista-documentos"><c:forEach items="${adjuntos.rows}" var="a"><c:if test="${a.entrega_id eq e.id}"><li><strong><c:out value="${empty a.etiqueta ? a.nombre : a.etiqueta}" /></strong> · Versión <c:out value="${a.numero}" /><div class="acciones-documento"><a href="<c:url value='/documento.jsp'><c:param name='version' value='${a.version_id}' /></c:url>">Previsualizar</a><a href="<c:out value='${a.url}' />" target="_blank" rel="noopener noreferrer">Abrir enlace ↗</a></div></li></c:if></c:forEach></ul><ol class="ruta-revisiones"><c:forEach items="${revisiones.rows}" var="r"><c:if test="${r.entrega_id eq e.id}"><li><p><strong><c:out value="${r.etapa}" /></strong> · <c:out value="${r.responsable}" /> <span class="insignia"><c:out value="${r.decision}" default="Pendiente" /></span></p><c:if test="${not empty r.limite}"><p class="dato-secundario">Límite: <c:out value="${r.limite}" /></p></c:if><c:if test="${not empty r.decidida}"><p class="dato-secundario">Respuesta: <c:out value="${r.decidida}" /></p></c:if><p class="texto-largo"><c:out value="${r.reporte_respuesta}" /></p></li></c:if></c:forEach></ol></article></c:forEach></section>
<%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
