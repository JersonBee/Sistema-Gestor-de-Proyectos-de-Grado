<section class="tarjeta detalle-cuenta"><h2>Fases de seguimiento</h2><p class="dato-secundario">Selecciona una fase iniciada para consultar sus detalles.</p><ol class="detalle-fases">
<c:forEach items="${fasesProyecto.rows}" var="fase"><li><span class="numero"><c:out value="${fase.orden}" /></span><c:choose><c:when test="${not empty fase.iniciada_en}"><button class="fase-abrir" type="button" popovertarget="fase-${fase.codigo}" aria-haspopup="dialog"><c:out value="${fase.nombre}" /><span class="fase-indicacion">Ver detalles ↗</span></button></c:when><c:otherwise><strong class="fase-futura"><c:out value="${fase.nombre}" /></strong></c:otherwise></c:choose><span class="insignia"><c:out value="${fase.estado}" default="${empty fase.iniciada_en ? 'Por iniciar' : 'En curso'}" /></span></li></c:forEach>
</ol></section>
<c:forEach items="${fasesProyecto.rows}" var="fase"><c:if test="${not empty fase.iniciada_en}">
<section id="fase-${fase.codigo}" class="ventana-fase" popover="auto" role="dialog" aria-labelledby="titulo-${fase.codigo}">
 <header class="ventana-cabecera"><div><p class="sobretitulo">FASE <c:out value="${fase.orden}" /> · PROYECTO #<c:out value="${param.id}" /></p><h2 id="titulo-${fase.codigo}"><c:out value="${fase.nombre}" /></h2></div><button class="boton" type="button" popovertarget="fase-${fase.codigo}" popovertargetaction="hide" aria-label="Cerrar detalles de ${fase.nombre}" autofocus>Cerrar ×</button></header>
 <div class="ventana-contenido"><p class="dato-secundario"><c:out value="${detalle.rows[0].titulo}" /> · Estado del proyecto: <c:out value="${detalle.rows[0].estado}" /></p>
 <dl class="lista-datos"><dt>Estado de la fase</dt><dd><c:out value="${fase.estado}" default="En curso" /></dd><dt>Inicio</dt><dd><c:out value="${fase.inicio}" /></dd><dt>Último cierre</dt><dd><c:out value="${fase.fin}" default="Sin cierre registrado" /></dd></dl><p class="dato-secundario">Fechas en hora de Bogotá. Puedes cerrar con Escape o pulsando fuera de la ventana.</p>
 <h3>Documentos de la última entrega en esta fase</h3><c:set var="hayDocumentosFase" value="false" /><ul class="lista-documentos"><c:forEach items="${documentosFases.rows}" var="d"><c:if test="${d.origen eq fase.codigo}"><c:set var="hayDocumentosFase" value="true" /><li><strong><c:out value="${empty d.etiqueta ? d.nombre : d.etiqueta}" /></strong><span class="dato-secundario"> · Versión <c:out value="${d.numero}" /><c:if test="${not empty d.entrega}"> · Entrega #<c:out value="${d.entrega}" /></c:if></span><div class="acciones-documento"><a class="boton" href="<c:url value='/documento.jsp'><c:param name='version' value='${d.version_id}' /></c:url>" target="_blank" rel="noopener">Previsualizar ↗</a><a href="<c:out value='${d.url}' />" target="_blank" rel="noopener noreferrer">Abrir enlace ↗</a></div></li></c:if></c:forEach></ul><c:if test="${not hayDocumentosFase}"><p class="dato-secundario">Todavía no hay documentos registrados en esta fase.</p></c:if>
 <c:if test="${fase.codigo eq 'propuesta_2' or fase.codigo eq 'informe_2'}"><p class="dato-secundario">Se muestran las versiones de la última entrega que llegó al evaluador o al Comité en esta fase. Una corrección pendiente del director todavía no sustituye este conjunto.</p></c:if>
 <h3>Revisiones y respuestas</h3><c:set var="hayRevisionesFase" value="false" /><div class="historial"><c:forEach items="${revisionesFases.rows}" var="r"><c:if test="${r.fase_codigo eq fase.codigo}"><c:set var="hayRevisionesFase" value="true" /><article><div class="titulo-tarjeta"><strong><c:out value="${r.responsable}" /> · <c:out value="${r.etapa}" /></strong><span class="insignia"><c:out value="${r.decision}" default="Pendiente" /></span></div><p class="dato-secundario">Entrega #<c:out value="${r.entrega}" /> · Asignada: <c:out value="${r.asignada}" /><c:if test="${not empty r.limite}"> · Límite: <c:out value="${r.limite}" /></c:if><c:if test="${not empty r.decidida}"> · Respuesta: <c:out value="${r.decidida}" /></c:if></p><p class="texto-largo"><c:out value="${r.reporte_respuesta}" default="Sin respuesta registrada." /></p></article></c:if></c:forEach></div><c:if test="${not hayRevisionesFase}"><p class="dato-secundario">No hay revisiones registradas para esta fase.</p></c:if>
 <c:if test="${fase.codigo eq 'final'}"><h3>Datos de cierre</h3><p class="dato-secundario">Los documentos adicionales son opcionales.</p><dl class="lista-datos"><dt>Licencia</dt><dd><c:out value="${datosFinales.rows[0].tipo_licencia}" default="Sin registrar" /></dd><dt>Repositorio</dt><dd><c:choose><c:when test="${not empty datosFinales.rows[0].repositorio_url}"><a href="<c:out value='${datosFinales.rows[0].repositorio_url}' />" target="_blank" rel="noopener noreferrer">Abrir repositorio ↗</a></c:when><c:otherwise>Sin registrar</c:otherwise></c:choose></dd></dl></c:if>
 </div><footer class="ventana-pie"><a class="boton primario" href="<c:url value='${fase.codigo eq "pago" ? "/pago.jsp" : (fase.codigo eq "final" ? "/final.jsp" : "/seguimiento.jsp")}'><c:param name='id' value='${param.id}' /><c:if test="${fase.codigo ne 'pago' and fase.codigo ne 'final'}"><c:param name='tipo' value='${fn:startsWith(fase.codigo,"propuesta") ? "propuesta" : "informe"}' /></c:if></c:url>">Abrir seguimiento completo →</a></footer>
</section>
</c:if></c:forEach>
