<c:choose><c:when test="${empty tareas.rows}"><p class="dato-secundario">No hay tareas disponibles en esta página. Los proyectos en espera o pausa se consultan desde Proyectos.</p></c:when><c:otherwise>
<c:forEach items="${tareas.rows}" var="t" end="${limiteTareas eq 6 ? 5 : 19}"><article class="fila-proyecto"><div><p class="identificador"><c:out value="${t.tipo}" /></p><h3><c:out value="${t.titulo}" /></h3><p class="dato-secundario"><c:out value="${t.accion}" /></p><c:if test="${not empty t.limite}"><p class="dato-secundario">Revisión hasta <c:out value="${t.limite}" /> · Hora de Bogotá<c:if test="${t.vencida}"> · Plazo alcanzado; el sistema procesa el vencimiento automáticamente.</c:if></p></c:if></div>
<a class="boton" aria-label="<c:out value='${t.accion}' />: <c:out value='${t.titulo}' />" href="<c:url value='${t.destino}'><c:param name='${t.tipo eq "acta" ? "acta" : "id"}' value='${t.recurso}' /><c:if test="${t.destino eq '/seguimiento.jsp'}"><c:param name='tipo' value='${t.recorrido}' /></c:if></c:url>">Atender →</a></article></c:forEach>
</c:otherwise></c:choose>
