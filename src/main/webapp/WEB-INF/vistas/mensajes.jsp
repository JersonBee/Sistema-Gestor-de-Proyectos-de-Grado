<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %><a class="volver" href="<c:url value='/proyecto.jsp'><c:param name='id' value='${param.id}' /></c:url>">← Detalle del proyecto</a><section class="bienvenida-panel"><div><p class="sobretitulo">CANAL ENTRE ESTUDIANTE Y DIRECTOR</p><h1 class="titulo-proyecto"><c:out value="${proyectoVista.titulo}" /></h1><p>Solo ves los mensajes que enviaste o recibiste.</p></div></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %>
<c:if test="${proyectoVista.estado eq 'activo' and not empty destinatarios.rows}"><form class="tarjeta formulario" method="post" action="<c:url value='/acciones/mensaje-enviar.jsp' />"><h2>Escribir mensaje</h2><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><label for="destinatario">Destinatario</label><select id="destinatario" name="destinatario" required><c:forEach items="${destinatarios.rows}" var="d"><option value="${d.id}"><c:out value="${d.nombre}" /></option></c:forEach></select><label for="contenido">Mensaje</label><textarea id="contenido" name="contenido" rows="4" maxlength="12000" required></textarea><button class="boton primario" type="submit">Enviar mensaje</button></form></c:if>
<c:if test="${not empty mensajes.rows}"><form method="post" action="<c:url value='/acciones/mensajes-leer.jsp' />"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="id" value="${param.id}"><button class="boton" type="submit">Marcar recibidos como leídos</button></form></c:if><c:if test="${empty mensajes.rows}"><section class="tarjeta estado-vacio"><h2>No tienes mensajes en este proyecto</h2></section></c:if>
<c:forEach items="${mensajes.rows}" var="m" end="19"><article class="tarjeta"><div class="titulo-tarjeta"><h2><c:out value="${m.remitente}" /> → <c:out value="${m.destinatario}" /></h2><span class="insignia">${empty m.leido_en ? 'Sin leer' : 'Leído'}</span></div><p class="texto-largo"><c:out value="${m.contenido}" /></p><p class="dato-secundario"><c:out value="${m.fecha}" /> · Hora de Bogotá</p></article></c:forEach><nav class="paginacion" aria-label="Páginas de mensajes"><c:if test="${pagina gt 1}"><a class="boton" href="<c:url value='/mensajes.jsp'><c:param name='id' value='${param.id}' /><c:param name='pagina' value='${pagina-1}' /></c:url>">← Anterior</a></c:if><span class="dato-secundario">Página <c:out value="${pagina}" /></span><c:if test="${mensajes.rowCount gt 20}"><a class="boton" href="<c:url value='/mensajes.jsp'><c:param name='id' value='${param.id}' /><c:param name='pagina' value='${pagina+1}' /></c:url>">Siguiente →</a></c:if></nav><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
