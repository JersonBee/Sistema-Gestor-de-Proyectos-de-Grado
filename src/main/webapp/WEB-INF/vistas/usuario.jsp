<%@ include file="/WEB-INF/vistas/comun/cabecera.jsp" %><%@ include file="/WEB-INF/vistas/comun/menu.jsp" %><a class="volver" href="<c:url value='/usuarios.jsp' />">← Cuentas</a><section class="bienvenida-panel"><div><p class="sobretitulo">CUENTA DE USUARIO</p><h1><c:out value="${cuenta.nombre}" /></h1><p><c:out value="${cuenta.correo}" /></p></div></section><%@ include file="/WEB-INF/vistas/comun/aviso.jsp" %><section class="tarjeta"><dl class="lista-datos"><dt>Documento</dt><dd><c:out value="${cuenta.numero_documento}" default="Sin registrar" /></dd><dt>Teléfono</dt><dd><c:out value="${cuenta.telefono}" default="Sin registrar" /></dd></dl></section>
<form class="tarjeta formulario" method="post" action="<c:url value='/acciones/cuenta-administrar.jsp' />"><h2>Rol y estado</h2><p class="dato-secundario">Cambiar el rol o estado revoca las sesiones anteriores. Desactivar una cuenta impide su acceso; para detener los plazos de un proyecto, usa la pausa del proyecto.</p><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}' />"><input type="hidden" name="usuario" value="${cuenta.id}"><label for="rol">Único rol</label><select id="rol" name="rol" required><c:forEach items="${roles.rows}" var="r"><option value="${r.codigo}" ${cuenta.rol_codigo eq r.codigo ? 'selected' : ''}><c:out value="${r.nombre}" /></option></c:forEach></select><label for="estado">Estado de acceso</label><select id="estado" name="estado" required><c:forTokens items="activo,inactivo,pendiente" delims="," var="e"><option value="${e}" ${cuenta.estado eq e ? 'selected' : ''}><c:out value="${e}" /></option></c:forTokens></select>
<c:if test="${not cuenta.tiene_perfil}"><details class="seccion-desplegable"><summary>Perfil requerido al asignar Director o Evaluador</summary><p class="dato-secundario">Completa este apartado solamente si vas a asignar un rol docente a una cuenta sin perfil.</p><label for="areas">Áreas de experiencia · Separadas por comas</label><input id="areas" name="areas" maxlength="2000"><label for="lineas">Líneas de investigación · Separadas por comas</label><input id="lineas" name="lineas" maxlength="2000"><label for="cursos">Cursos</label><textarea id="cursos" name="cursos" rows="2" maxlength="4000"></textarea><label for="titulos">Títulos académicos</label><textarea id="titulos" name="titulos" rows="2" maxlength="4000"></textarea><label for="temas">Temas de preferencia</label><textarea id="temas" name="temas" rows="2" maxlength="4000"></textarea><fieldset><legend>Modalidades</legend><div class="opciones-modalidad"><c:forEach items="${modalidades.rows}" var="m"><label class="opcion-check"><input type="checkbox" name="modalidad" value="${m.codigo}"><c:out value="${m.nombre}" /></label></c:forEach></div></fieldset></details></c:if><button class="boton primario" type="submit">Guardar rol y estado</button></form>
<c:if test="${not empty movimientos.rows}"><section class="tarjeta historial"><h2>Cambios recientes de acceso</h2><c:forEach items="${movimientos.rows}" var="m"><article><p class="dato-secundario"><c:out value="${m.fecha}" /> · <c:out value="${m.nombre}" /></p><p class="texto-largo"><c:out value="${m.rol_anterior}" /> / <c:out value="${m.estado_anterior}" /> → <c:out value="${m.rol_nuevo}" /> / <c:out value="${m.estado_nuevo}" /></p></article></c:forEach></section></c:if><%@ include file="/WEB-INF/vistas/comun/pie-panel.jsp" %>
