digraph MER {
graph [rankdir=LR, bgcolor="white", pad="0.5", nodesep="0.55", ranksep="0.9", splines=polyline, outputorder=edgesfirst, dpi=150, fontname="DejaVu Sans", fontsize=17, labelloc=t, labeljust=l, label=<<B>MER COMPLETO</B><BR ALIGN="LEFT"/>Sistema Gestor de Proyectos de Grado · PostgreSQL / grado<BR ALIGN="LEFT"/><FONT POINT-SIZE="12">37 tablas · 212 campos · 66 claves foráneas · 19 octubre 2026<BR ALIGN="LEFT"/>PK: clave primaria · FK: clave foránea · NULL: campo opcional<BR ALIGN="LEFT"/>Las cardinalidades describen filas históricas. Las restricciones de vigencia se explican en las notas.</FONT>>];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=9, fontcolor="#455A64", color="#83998D", penwidth=1.1, arrowsize=0.7, labeldistance=1.6];
