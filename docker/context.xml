<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <Valve className="org.apache.catalina.valves.RemoteIpValve" protocolHeader="x-forwarded-proto" />
    <!-- Componentes incluidos en Tomcat; no hay servlets ni clases Java propias. -->
    <Valve className="org.apache.catalina.valves.PersistentValve" filter="/assets/.*|/salud\.jsp" />
    <Manager className="org.apache.catalina.session.PersistentManager"
             sessionActivityCheck="true" saveOnRestart="false"
             sessionAttributeValueClassNameFilter="java\.lang\.(String|Long|Integer|Boolean|Number)"
             warnOnSessionAttributeFilterFailure="true">
        <Store className="org.apache.catalina.session.DataSourceStore"
               dataSourceName="jdbc/Grado" localDataSource="true"
               sessionTable="grado.sesion_http" sessionAppCol="aplicacion"
               sessionIdCol="id" sessionDataCol="datos" sessionValidCol="valida"
               sessionMaxInactiveCol="inactividad_maxima" sessionLastAccessedCol="ultimo_acceso" />
    </Manager>
    <CookieProcessor sameSiteCookies="lax" />
    <!-- Sustitución por EnvironmentPropertySource; sin secretos en el WAR. -->
    <Resource name="jdbc/Grado" auth="Container" type="javax.sql.DataSource"
              factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
              driverClassName="org.postgresql.Driver"
              url="${DB_JDBC_URL}" username="${DB_USER}" password="${DB_PASSWORD}"
              initialSize="0" minIdle="0" maxIdle="2" maxActive="5" maxWait="10000"
              testOnBorrow="true" validationQuery="SELECT 1"
              defaultAutoCommit="true" />
</Context>
